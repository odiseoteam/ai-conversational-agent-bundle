<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <mapped-superclass name="Odiseo\AiConversationalAgentBundle\Bridge\Doctrine\Model\SpendEntry">
        <indexes>
            <index name="idx_agent_spend_session" columns="session_id" />
            <index name="idx_agent_spend_day" columns="spent_on" />
            <index name="idx_agent_spend_client" columns="client_key,spent_on" />
        </indexes>

        <id name="id" column="id" type="integer">
            <generator strategy="AUTO" />
        </id>

        <field name="sessionId" column="session_id" type="string" length="64" />
        <field name="clientKey" column="client_key" type="string" length="64" nullable="true" />
        <field name="spentOn" column="spent_on" type="date_immutable" />
        <field name="usd" column="usd" type="decimal" precision="12" scale="6" />
        <field name="model" column="model" type="string" length="64" nullable="true" />
        <field name="inputTokens" column="input_tokens" type="integer" />
        <field name="outputTokens" column="output_tokens" type="integer" />
        <field name="cacheCreationTokens" column="cache_creation_tokens" type="integer" />
        <field name="cacheReadTokens" column="cache_read_tokens" type="integer" />
        <field name="createdAt" column="created_at" type="datetime_immutable" />
    </mapped-superclass>
</doctrine-mapping>
