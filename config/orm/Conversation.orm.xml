<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <!-- The host's entity names the table; indexes and constraints are inherited. -->
    <mapped-superclass name="Odiseo\AiConversationalAgentBundle\Bridge\Doctrine\Model\Conversation">
        <unique-constraints>
            <unique-constraint name="uniq_agent_conversation_session" columns="session_id" />
        </unique-constraints>
        <indexes>
            <index name="idx_agent_conversation_principal" columns="principal_id,expires_at,updated_at" />
            <index name="idx_agent_conversation_expires" columns="expires_at" />
        </indexes>

        <id name="id" column="id" type="integer">
            <generator strategy="AUTO" />
        </id>

        <field name="sessionId" column="session_id" type="string" length="64" />
        <field name="principalId" column="principal_id" type="string" length="255" />
        <field name="version" column="version" type="integer" version="true" />
        <field name="state" column="state" type="json" />
        <field name="pendingAppEvents" column="pending_app_events" type="json" />
        <field name="createdAt" column="created_at" type="datetime_immutable" />
        <field name="updatedAt" column="updated_at" type="datetime_immutable" />
        <field name="expiresAt" column="expires_at" type="datetime_immutable" />
    </mapped-superclass>
</doctrine-mapping>
