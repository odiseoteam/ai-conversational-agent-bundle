{
    "name": "odiseoteam/ai-conversational-agent-bundle",
    "description": "Vertical-agnostic core for conversational agents: capabilities, turn loop, gates, sessions, streaming and evals.",
    "type": "symfony-bundle",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "psr/log": "^3.0",
        "symfony/config": "^7.3|^8.0",
        "symfony/console": "^7.3|^8.0",
        "symfony/dependency-injection": "^7.3|^8.0",
        "symfony/event-dispatcher": "^7.3|^8.0",
        "symfony/http-foundation": "^7.3|^8.0",
        "symfony/http-kernel": "^7.3|^8.0",
        "symfony/rate-limiter": "^7.3|^8.0",
        "symfony/yaml": "^7.3|^8.0"
    },
    "require-dev": {
        "deptrac/deptrac": "^3.0",
        "doctrine/dbal": "^4.2",
        "doctrine/doctrine-bundle": "^2.13",
        "doctrine/orm": "^3.3",
        "doctrine/persistence": "^4.0",
        "friendsofphp/php-cs-fixer": "^3.68",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5",
        "shipmonk/composer-dependency-analyser": "^1.8",
        "symfony/ai-anthropic-platform": "^0.13",
        "symfony/ai-platform": "^0.13"
    },
    "suggest": {
        "doctrine/doctrine-bundle": "Registers the ORM mappings",
        "doctrine/orm": "For the ORM session, memory and spend-ledger stores",
        "symfony/ai-anthropic-platform": "For the Anthropic model provider adapter"
    },
    "autoload": {
        "psr-4": {
            "Odiseo\\AiConversationalAgentBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Odiseo\\AiConversationalAgentBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "extra": {
        "branch-alias": {
            "dev-master": "0.2-dev"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix"
    }
}
